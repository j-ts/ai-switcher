# ClaudeCodePortable generates these at runtime -- never commit.
app/
profiles/
build/
dist/
# Per-platform agm binaries: CI drops them into bin/<platform>/ at packaging time
bin/*/
ais-version.txt
# KDE service-menu wrappers, written per tool+profile with absolute local paths
launcher/kde-service-*.sh

# Backups + editor droppings
*.bak
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# Local-only scratch
_*.bat
_*.ps1
_*.ps1_
_*.mjs
_*.sh

# Python bytecode
__pycache__/
*.pyc

# Kept local on purpose: the repository ships no README
/README.md
